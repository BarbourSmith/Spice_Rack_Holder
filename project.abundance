            },
            {
              "atomType": "Code",
              "x": 0.9,
              "y": 0.6,
              "uniqueID": "id-5733",
              "ioValues": [
                {
                  "name": "railGap",
                  "ioValue": 18.75
                },
                {
                  "name": "flip",
                  "ioValue": false
                },
                {
                  "name": "tabHeight",
                  "ioValue": 30
                },
                {
                  "name": "reach",
                  "ioValue": 13
                },
                {
                  "name": "filletRadius",
                  "ioValue": 8
                },
                {
                  "name": "cornerRadius",
                  "ioValue": 5
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * 2D outline of a wall-hole tab, centered on the hole.\n * The tab reaches back into the side rail and has concave fillets\n * where it meets the rail edge, plus rounded outer corners.\n * railGap: distance from hole center to the rail's outer edge (mm)\n * flip: false = rail is toward -x (right tab), true = toward +x (left tab)\n */\nfunction run(\n  railGap: number = 18.75,\n  flip: boolean = false,\n  tabHeight: number = 30,\n  reach: number = 13,\n  filletRadius: number = 8,\n  cornerRadius: number = 5,\n): Assembly {\n  const s = flip ? -1 : 1;\n  const h = tabHeight / 2;\n  const xr = -railGap; // rail edge\n  const xi = xr - 5; // overlap into the rail so the fusion is solid\n  const yb = h + filletRadius + 2; // room along the rail for the fillet\n  const outline = replicad\n    .draw([s * xi, -yb])\n    .lineTo([s * xr, -yb])\n    .lineTo([s * xr, -h])\n    .customCorner(filletRadius)\n    .lineTo([s * reach, -h])\n    .customCorner(cornerRadius)\n    .lineTo([s * reach, h])\n    .customCorner(cornerRadius)\n    .lineTo([s * xr, h])\n    .customCorner(filletRadius)\n    .lineTo([s * xr, yb])\n    .lineTo([s * xi, yb])\n    .close();\n  return new Assembly({ geometry: outline });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * 2D outline of a wall-hole tab, centered on the hole.\n * The tab reaches back into the side rail and has concave fillets\n * where it meets the rail edge, plus rounded outer corners.\n * railGap: distance from hole center to the rail's outer edge (mm)\n * flip: false = rail is toward -x (right tab), true = toward +x (left tab)\n */\nfunction run(railGap = 18.75, flip = false, tabHeight = 30, reach = 13, filletRadius = 8, cornerRadius = 5) {\n    const s = flip ? -1 : 1;\n    const h = tabHeight / 2;\n    const xr = -railGap; // rail edge\n    const xi = xr - 5; // overlap into the rail so the fusion is solid\n    const yb = h + filletRadius + 2; // room along the rail for the fillet\n    const outline = replicad\n        .draw([s * xi, -yb])\n        .lineTo([s * xr, -yb])\n        .lineTo([s * xr, -h])\n        .customCorner(filletRadius)\n        .lineTo([s * reach, -h])\n        .customCorner(cornerRadius)\n        .lineTo([s * reach, h])\n        .customCorner(cornerRadius)\n        .lineTo([s * xr, h])\n        .customCorner(filletRadius)\n        .lineTo([s * xr, yb])\n        .lineTo([s * xi, yb])\n        .close();\n    return new Assembly({ geometry: outline });\n}\n"
            }
          ],
